# Copy to .env and fill in. docker-compose reads this file automatically.
#
# NOTE: the values that used to be committed in djangopj/settings.py are in the
# git history and must be rotated, not just moved here.

# --- Django ---
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated. Leave empty to allow all origins (the previous behaviour).
DJANGO_CORS_ALLOWED_ORIGINS=

# --- Database ---
DB_NAME=django-db
DB_USER=django
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-me

# --- Social auth ---
SOCIAL_AUTH_FACEBOOK_KEY=
SOCIAL_AUTH_FACEBOOK_SECRET=
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=

# --- HTTPS hardening (enable once TLS termination is confirmed) ---
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_HSTS_SECONDS=0
# Set True when a reverse proxy terminates TLS and sets X-Forwarded-Proto.
DJANGO_BEHIND_TLS_PROXY=False
