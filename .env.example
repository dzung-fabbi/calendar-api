# Copy to .env and fill in. docker-compose reads this file automatically.
#
# NOTE: the values that used to be committed in djangopj/settings.py are in the
# git history and must be rotated, not just moved here.

# --- Django ---
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated. Leave empty to allow all origins (the previous behaviour).
DJANGO_CORS_ALLOWED_ORIGINS=

# --- Database ---
DB_NAME=django-db
DB_USER=django
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-me

# --- HTTPS hardening (enable once TLS termination is confirmed) ---
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_HSTS_SECONDS=0
# Set True when a reverse proxy terminates TLS and sets X-Forwarded-Proto.
DJANGO_BEHIND_TLS_PROXY=False
# Number of TRUSTED reverse proxies in front of Django (DRF throttling's
# NUM_PROXIES -- controls how X-Forwarded-For is trusted for per-IP rate
# limits, e.g. 'giapha-join'/'giapha-public'). 0 = Django is edge-facing and
# X-Forwarded-For is ignored entirely (the safe default with no proxy).
# Set it to the ACTUAL number of trusted proxies (usually 1) once
# nginx/Cloudflare/a load balancer sits in front -- a wrong count either
# lets a client forge its own throttle bucket via a fake header (too high)
# or buckets every real user together behind the proxy's IP (too low).
DJANGO_NUM_PROXIES=0

# --- Firebase Cloud Messaging (nhac gio push) ---
# HTTP v1 needs a service account; the legacy server key was switched off in
# June 2024. Set EITHER the path to the JSON file OR its raw contents --
# JSON wins when both are set. Leave both empty and
# `manage.py remind_death_anniversary` logs a warning and exits 0.
# NEVER commit the service account file: see .gitignore.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# --- Object storage (gia pha anh chan dung, phase 8) ---
# S3 or Cloudflare R2 -- boto3 talks to both, only the endpoint/region differ.
# Leave all five empty and the photo upload/confirm/delete/photo-urls endpoints
# answer 503; the rest of the API keeps working unaffected.
# Bucket MUST be private -- photo_url is always a presigned, time-limited link,
# never a public one. See docs/deployment-guide.md for bucket CORS setup.
# S3: leave S3_ENDPOINT_URL empty. R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 uses "auto". S3 uses a real region, e.g. ap-southeast-1.
S3_REGION=

# --- Email (password-reset OTP) ---
# Leave EMAIL_HOST EMPTY to print emails to stdout instead of sending them
# (local dev / CI). Setting it switches Django to the real SMTP backend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Socket timeout in seconds. Django defaults to none at all, which lets one
# unreachable mail server tie up a worker indefinitely.
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@example.com

# Password-reset OTP policy. 600s = 10 minutes.
PASSWORD_RESET_CODE_TTL_SECONDS=600
PASSWORD_RESET_MAX_ATTEMPTS=5

# --- JWT auth (/api/auth/login, refresh, logout) ---
# Leave empty to reuse DJANGO_SECRET_KEY. Set it (and rotate it independently)
# once you want "log everyone out" to be a one-variable operation. Must be
# identical on every app container.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=
# Access token lifetime (1h). It cannot be revoked early except by a password
# change, so keep it short.
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=3600
# Refresh token lifetime (30 days). Single-use: every refresh rotates it.
JWT_REFRESH_TOKEN_LIFETIME_SECONDS=2592000
